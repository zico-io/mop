{
  "name": "mop-harness",
  "version": "0.1.0",
  "description": "A strict, layered ESLint harness for cleaning up what a branch changed. Ships the mop Claude Code plugin.",
  "type": "module",
  "license": "MIT",
  "repository": "https://github.com/zico-io/mop",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "bin": {
    "mop-lint": "./dist/mop-lint.mjs",
    "mop-judge": "./dist/mop-judge.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "prepare": "npm run build",
    "typecheck": "tsc",
    "test": "node --import tsx --test test/*.test.ts",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/sync-plugin-version.ts",
    "release": "changeset publish"
  },
  "dependencies": {
    "@eslint-react/eslint-plugin": "5.20.8",
    "@vitest/eslint-plugin": "1.6.27",
    "eslint": "10.11.0",
    "eslint-plugin-better-max-params": "1.0.0",
    "eslint-plugin-no-comments": "1.2.1",
    "eslint-plugin-playwright": "2.12.0",
    "eslint-plugin-security": "4.1.0",
    "eslint-plugin-sonarjs": "4.2.1",
    "eslint-plugin-tailwindcss": "4.4.0",
    "eslint-plugin-unicorn": "76.0.0",
    "globals": "17.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@types/estree": "1.0.9",
    "@types/node": "24.19.1",
    "tsdown": "0.23.0",
    "tsx": "4.23.15"
  },
  "packageManager": "pnpm@12.10.1+sha512.ba40a37eb1a370d60fea8c4cf1d364c13bcccef518e98ad2bcee954f539d38da37458e58261a3fa55e06523450ea0ffff9f497b135be41f2c15c1642bacace6c",
  "keywords": [
    "eslint",
    "eslint-config",
    "lint",
    "slop",
    "claude-code"
  ]
}
